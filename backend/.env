CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:80/'

database.default.hostname = ${DB_HOST}
database.default.database = ${DB_NAME}
database.default.username = ${DB_USER}
database.default.password = ${DB_PASS}
database.default.port = ${DB_PORT}
database.default.DBDriver = MySQLi

cache.handler = redis
cache.redis.host = ${REDIS_HOST}
cache.redis.port = ${REDIS_PORT}
cache.redis.password = 
cache.redis.database = 0
cache.redis.ttl = 3600

session.driver = redis
session.savePath = 'tcp://${REDIS_HOST}:${REDIS_PORT}'
session.sessionMatchIP = false
session.timeToUpdate = 300
session.expiration = 7200
